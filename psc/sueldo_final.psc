Algoritmo sueldo_final
	Definir sueldoi, descuento, sueldof Como Real
	Escribir 'Ingrese el sueldo inicial: '
	Leer sueldoi
	descuento <- sueldoi*0.12
	sueldof <- sueldoi-descuento
	Escribir 'El valor del descuento (12%) es: ', descuento
	Escribir 'El sueldo neto a pagar es: ', sueldof
FinAlgoritmo
